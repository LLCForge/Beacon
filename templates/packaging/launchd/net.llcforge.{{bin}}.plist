<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  {{name}} launchd daemon for macOS.
  Install:
    sudo mkdir -p /usr/local/etc/{{bin}} /usr/local/var/lib/{{bin}} /usr/local/var/log
    sudo cp {{bin}}.example.toml /usr/local/etc/{{bin}}/{{bin}}.toml
    sudo chown -R nobody:nobody /usr/local/var/lib/{{bin}}
    sudo touch /usr/local/var/log/{{bin}}.log && sudo chown nobody /usr/local/var/log/{{bin}}.log
    sudo cp net.llcforge.{{bin}}.plist /Library/LaunchDaemons/
    sudo launchctl bootstrap system /Library/LaunchDaemons/net.llcforge.{{bin}}.plist
  Reload config: sudo launchctl kill HUP system/net.llcforge.{{bin}}
  Secrets: add them under EnvironmentVariables below and keep this file
  mode 0600 root:wheel, or source them from a wrapper script.
  On Apple silicon with Homebrew, the binary lives in /opt/homebrew/bin.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.llcforge.{{bin}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/{{bin}}</string>
    <string>run</string>
    <string>--config</string>
    <string>/usr/local/etc/{{bin}}/{{bin}}.toml</string>
  </array>
  <key>UserName</key>
  <string>nobody</string>
  <key>GroupName</key>
  <string>nobody</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>STATE_DIRECTORY</key>
    <string>/usr/local/var/lib/{{bin}}</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/lib/{{bin}}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/{{bin}}.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/{{bin}}.log</string>
</dict>
</plist>
